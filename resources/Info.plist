<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>sage-voiced</string>
  <key>CFBundleIdentifier</key>
  <string>local.sage.voicebridge</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>SAGE Voice Bridge</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <!-- Agent, not an app with a Dock icon: this is an always-on appliance the
       owner reaches by voice message, not something they switch to. -->
  <key>LSUIElement</key>
  <true/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- Not needed for Phase 1 (audio arrives as a Signal attachment), but a
       live call is on the roadmap and adding the key later would re-prompt. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>SAGE Voice Bridge needs microphone access for live voice calls. Audio is transcribed on this Mac and never uploaded.</string>
  <key>SageVoiceBridgeReleaseLabel</key>
  <string></string>
</dict>
</plist>
